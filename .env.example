# ==============================================================================
# Daily Dental Care - Production Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (e.g., AWS RDS, Supabase, Neon, Railway, Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental_clinic"

# Set to "false" to disable SSL for local development or set to "true" / omit for production cloud DBs
DB_SSL="false"

# Maximum database pool connections for production traffic (Default: 20)
DB_MAX_CONNECTIONS=20

# Node Environment
NODE_ENV="production"

# Base Website URL (Used for Canonical SEO, OpenGraph tags, sitemap.xml)
NEXT_PUBLIC_SITE_URL="https://dailydentalcare.in"

# Seed Admin & Receptionist Default Credentials (Used only during initial db:seed)
SEED_ADMIN_PASSWORD="ChangeMeInProduction!123"
SEED_STAFF_PASSWORD="ChangeMeInProduction!123"
